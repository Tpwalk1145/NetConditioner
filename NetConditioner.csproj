<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NetConditioner</AssemblyName>
    <RootNamespace>NetConditioner</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CETCompat>false</CETCompat>
    <Version>1.1.0</Version>
    <Product>NetConditioner</Product>
    <Company>NetConditioner</Company>
  </PropertyGroup>

  <ItemGroup>
    <None Update="third_party\WinDivert\WinDivert.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>WinDivert.dll</TargetPath>
    </None>
    <None Update="third_party\WinDivert\WinDivert64.sys">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>WinDivert64.sys</TargetPath>
    </None>
    <None Update="third_party\WinDivert\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>third_party\WinDivert\LICENSE</TargetPath>
    </None>
    <None Update="third_party\WinDivert\VERSION">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>third_party\WinDivert\VERSION</TargetPath>
    </None>
    <None Update="third_party\WinDivert\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>third_party\WinDivert\README.txt</TargetPath>
    </None>
  </ItemGroup>

</Project>
